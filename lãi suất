import streamlit as st

# =========================================================
# CẤU HÌNH TRANG
# =========================================================

st.set_page_config(
    page_title="Tính lãi tiền gửi tiết kiệm",
    page_icon="💰",
    layout="centered"
)

# =========================================================
# CSS - GIAO DIỆN
# =========================================================

st.markdown("""
<style>
    .main-title {
        text-align: center;
        color: #1f4e79;
        font-size: 36px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .sub-title {
        text-align: center;
        color: #666666;
        margin-bottom: 30px;
    }

    .result-box {
        padding: 20px;
        border-radius: 10px;
        background-color: #f0f8ff;
        border: 1px solid #cce5ff;
        margin-top: 10px;
    }
</style>
""", unsafe_allow_html=True)


# =========================================================
# HÀM ĐỊNH DẠNG TIỀN
# =========================================================

def dinh_dang_tien(so_tien):
    return f"{so_tien:,.0f} VNĐ".replace(",", ".")


# =========================================================
# TIÊU ĐỀ
# =========================================================

st.markdown(
    '<div class="main-title">💰 TÍNH LÃI TIỀN GỬI TIẾT KIỆM</div>',
    unsafe_allow_html=True
)

st.markdown(
    '<div class="sub-title">'
    'Tính toán tiền lãi theo phương pháp lãi đơn hoặc lãi kép'
    '</div>',
    unsafe_allow_html=True
)


# =========================================================
# NHẬP THÔNG TIN
# =========================================================

st.subheader("📋 Thông tin khoản tiền gửi")

tien_gui = st.number_input(
    "💵 Số tiền gửi (VNĐ)",
    min_value=0,
    value=100_000_000,
    step=1_000_000,
    format="%d"
)

ky_han = st.number_input(
    "📅 Kỳ hạn (tháng)",
    min_value=1,
    max_value=120,
    value=12,
    step=1
)

lai_suat = st.number_input(
    "📈 Lãi suất (%/năm)",
    min_value=0.0,
    max_value=100.0,
    value=6.0,
    step=0.1,
    format="%.2f"
)

phuong_phap = st.selectbox(
    "🧮 Phương pháp tính lãi",
    [
        "Lãi đơn",
        "Lãi kép"
    ]
)

hinh_thuc = st.selectbox(
    "💳 Hình thức nhận lãi",
    [
        "Cuối kỳ",
        "Hàng tháng",
        "Hàng quý"
    ]
)


# =========================================================
# NÚT TÍNH
# =========================================================

if st.button(
    "🧮 TÍNH LÃI",
    use_container_width=True
):

    # -----------------------------------------------------
    # KIỂM TRA DỮ LIỆU
    # -----------------------------------------------------

    if tien_gui <= 0:
        st.error("❌ Số tiền gửi phải lớn hơn 0.")

    elif lai_suat < 0:
        st.error("❌ Lãi suất không được nhỏ hơn 0.")

    elif ky_han <= 0:
        st.error("❌ Kỳ hạn phải lớn hơn 0.")

    else:

        # =================================================
        # LÃI SUẤT
        # =================================================

        lai_suat_nam = lai_suat / 100

        # =================================================
        # TRƯỜNG HỢP 1: LÃI ĐƠN
        # =================================================

        if phuong_phap == "Lãi đơn":

            # Tổng lãi:
            # Tiền gốc × lãi suất năm × số tháng / 12

            tong_tien_lai = (
                tien_gui
                * lai_suat_nam
                * ky_han
                / 12
            )

            tong_tien_nhan = (
                tien_gui
                + tong_tien_lai
            )

            # -------------------------------------------------
            # LÃI ĐỊNH KỲ
            # -------------------------------------------------

            if hinh_thuc == "Hàng tháng":

                lai_dinh_ky = (
                    tien_gui
                    * lai_suat_nam
                    / 12
                )

                ten_ky = "tháng"

            elif hinh_thuc == "Hàng quý":

                lai_dinh_ky = (
                    tien_gui
                    * lai_suat_nam
                    / 4
                )

                ten_ky = "quý"

            else:

                lai_dinh_ky = tong_tien_lai
                ten_ky = "cuối kỳ"

        # =================================================
        # TRƯỜNG HỢP 2: LÃI KÉP
        # =================================================

        else:

            # -------------------------------------------------
            # LÃI KÉP THEO KỲ NHẬN LÃI
            # -------------------------------------------------

            if hinh_thuc == "Hàng tháng":

                # Lãi suất tháng
                lai_suat_ky = lai_suat_nam / 12

                # Số kỳ
                so_ky = ky_han

                # Giá trị cuối kỳ
                tong_tien_nhan = (
                    tien_gui
                    * (1 + lai_suat_ky) ** so_ky
                )

                tong_tien_lai = (
                    tong_tien_nhan
                    - tien_gui
                )

                # Lãi của kỳ đầu tiên
                lai_dinh_ky = (
                    tien_gui
                    * lai_suat_ky
                )

                ten_ky = "tháng"

            elif hinh_thuc == "Hàng quý":

                # Lãi suất quý
                lai_suat_ky = lai_suat_nam / 4

                # Số quý
                so_ky = ky_han / 3

                # Nếu kỳ hạn không đủ một quý
                if so_ky < 1:

                    tong_tien_nhan = (
                        tien_gui
                        * (
                            1
                            + lai_suat_nam
                            * ky_han
                            / 12
                        )
                    )

                    tong_tien_lai = (
                        tong_tien_nhan
                        - tien_gui
                    )

                    lai_dinh_ky = tong_tien_lai

                else:

                    tong_tien_nhan = (
                        tien_gui
                        * (1 + lai_suat_ky) ** so_ky
                    )

                    tong_tien_lai = (
                        tong_tien_nhan
                        - tien_gui
                    )

                    lai_dinh_ky = (
                        tien_gui
                        * lai_suat_ky
                    )

                ten_ky = "quý"

            else:

                # ---------------------------------------------
                # LÃI KÉP CUỐI KỲ
                # ---------------------------------------------

                # Số năm gửi
                so_nam = ky_han / 12

                # Quy đổi theo năm
                tong_tien_nhan = (
                    tien_gui
                    * (1 + lai_suat_nam) ** so_nam
                )

                tong_tien_lai = (
                    tong_tien_nhan
                    - tien_gui
                )

                lai_dinh_ky = tong_tien_lai

                ten_ky = "cuối kỳ"

        # =================================================
        # HIỂN THỊ KẾT QUẢ
        # =================================================

        st.success("✅ Đã tính toán thành công!")

        st.subheader("📊 KẾT QUẢ")

        # -------------------------------------------------
        # THÔNG TIN PHƯƠNG PHÁP
        # -------------------------------------------------

        col1, col2 = st.columns(2)

        with col1:
            st.metric(
                "🧮 Phương pháp",
                phuong_phap
            )

        with col2:
            st.metric(
                "💳 Hình thức nhận lãi",
                hinh_thuc
            )

        st.divider()

        # -------------------------------------------------
        # KẾT QUẢ CHÍNH
        # -------------------------------------------------

        col1, col2 = st.columns(2)

        with col1:
            st.metric(
                "💵 Tiền lãi định kỳ",
                dinh_dang_tien(lai_dinh_ky)
            )

        with col2:
            st.metric(
                "📈 Tổng tiền lãi",
                dinh_dang_tien(tong_tien_lai)
            )

        col3, col4 = st.columns(2)

        with col3:
            st.metric(
                "🏦 Tiền gốc",
                dinh_dang_tien(tien_gui)
            )

        with col4:
            st.metric(
                "💰 Tổng gốc + lãi",
                dinh_dang_tien(tong_tien_nhan)
            )

        # =================================================
        # CHI TIẾT
        # =================================================

        st.divider()

        st.subheader("📝 Chi tiết khoản tiền gửi")

        st.write(
            f"**Số tiền gửi:** "
            f"{dinh_dang_tien(tien_gui)}"
        )

        st.write(
            f"**Kỳ hạn:** "
            f"{ky_han} tháng"
        )

        st.write(
            f"**Lãi suất:** "
            f"{lai_suat:.2f}%/năm"
        )

        st.write(
            f"**Phương pháp:** "
            f"{phuong_phap}"
        )

        st.write(
            f"**Hình thức nhận lãi:** "
            f"{hinh_thuc}"
        )

        # =================================================
        # THÔNG BÁO
        # =================================================

        if phuong_phap == "Lãi đơn":

            if hinh_thuc == "Cuối kỳ":

                st.info(
                    "ℹ️ Với lãi đơn, tiền lãi được tính "
                    "trên số tiền gốc ban đầu và không cộng "
                    "lãi vào vốn."
                )

            else:

                st.info(
                    f"ℹ️ Mỗi {ten_ky}, số tiền lãi nhận được "
                    f"là khoảng "
                    f"**{dinh_dang_tien(lai_dinh_ky)}**."
                )

        else:

            st.info(
                "ℹ️ Với lãi kép, tiền lãi được cộng vào "
                "vốn để tiếp tục sinh lãi ở các kỳ tiếp theo."
            )

        # =================================================
        # SO SÁNH LÃI ĐƠN - LÃI KÉP
        # =================================================

        st.divider()

        st.subheader("📊 So sánh lãi đơn và lãi kép")

        # Tính lại lãi đơn để so sánh
        lai_don = (
            tien_gui
            * lai_suat_nam
            * ky_han
            / 12
        )

        tien_cuoi_ky_lai_don = (
            tien_gui + lai_don
        )

        # Tính lãi kép theo năm
        so_nam = ky_han / 12

        tien_cuoi_ky_lai_kep = (
            tien_gui
            * (1 + lai_suat_nam) ** so_nam
        )

        lai_kep = (
            tien_cuoi_ky_lai_kep
            - tien_gui
        )

        col1, col2 = st.columns(2)

        with col1:

            st.markdown("### 🔵 Lãi đơn")

            st.write(
                f"Tiền lãi: **{dinh_dang_tien(lai_don)}**"
            )

            st.write(
                f"Tổng nhận: **"
                f"{dinh_dang_tien(tien_cuoi_ky_lai_don)}**"
            )

        with col2:

            st.markdown("### 🟢 Lãi kép")

            st.write(
                f"Tiền lãi: **{dinh_dang_tien(lai_kep)}**"
            )

            st.write(
                f"Tổng nhận: **"
                f"{dinh_dang_tien(tien_cuoi_ky_lai_kep)}**"
            )

        # =================================================
        # LÃI KÉP CAO HƠN LÃI ĐƠN
        # =================================================

        chenh_lech = (
            lai_kep - lai_don
        )

        if chenh_lech > 0:

            st.success(
                f"📈 Với các thông số hiện tại, "
                f"lãi kép tạo ra nhiều hơn lãi đơn khoảng "
                f"**{dinh_dang_tien(chenh_lech)}**."
            )

        elif chenh_lech == 0:

            st.info(
                "Hai phương pháp cho kết quả bằng nhau "
                "với các thông số hiện tại."
            )

        # =================================================
        # LƯU Ý
        # =================================================

        st.caption(
            "⚠️ Lưu ý: Đây là công cụ mô phỏng. "
            "Kết quả thực tế có thể khác tùy theo quy định "
            "của từng ngân hàng, cách tính ngày, kỳ hạn, "
            "lãi suất thực tế, thuế và các điều kiện của "
            "sản phẩm tiền gửi."
        )
